{
  "name": "dsh-companion",
  "version": "0.5.2",
  "description": "A persistent character workspace with independent Minecraft, QQ, Heybox and Bilibili channels for DSH.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "tools",
    "data",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/check.mjs",
    "migrate": "node tools/migrate.mjs"
  },
  "dependencies": {
    "minecraft-data": "3.117.0",
    "minecraft-protocol": "1.68.0",
    "mineflayer": "4.39.0",
    "mineflayer-collectblock": "1.6.0",
    "mineflayer-pathfinder": "2.4.5",
    "qrcode": "1.5.4",
    "undici": "7.30.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "esbuild": "0.25.12",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "license": "MIT"
}
